# Browser session state from research agents driving playwright-cli
.playwright-cli/

# Python / OS noise
__pycache__/
*.py[cod]
.DS_Store
.venv/

# Local JavaScript dependencies and deployment credentials
node_modules/
.env.local

# Local browser verification artifacts
output/playwright/
